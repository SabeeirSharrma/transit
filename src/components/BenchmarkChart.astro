---
// BenchmarkChart.astro
---

<div class="benchmark-container">
  <div class="benchmark-header">
    <h3>Chat Server: Fan-out Delivery</h3>
    <p>
      Average Operations per second across all benchmarks (Higher is better)
    </p>
  </div>

  <div class="chart">
    <div class="bar-row">
      <div class="label">Transit (Python, Rust, Java)</div>
      <div class="bar-container">
        <div class="bar transit" style="width: 60%;">
          <span class="value"
            >100,000.00 ops/s <span class="ms">(0.01ms)</span></span
          >
        </div>
      </div>
    </div>

    <div class="bar-row">
      <div class="label">ZeroMQ</div>
      <div class="bar-container">
        <div class="bar others" style="width: 38%;">
          <span class="value"
            >8,333.33 ops/s <span class="ms">(0.12ms)</span></span
          >
        </div>
      </div>
    </div>

    <div class="bar-row">
      <div class="label">Thrift</div>
      <div class="bar-container">
        <div class="bar others" style="width: 34%;">
          <span class="value"
            >7,142.86 ops/s <span class="ms">(0.14ms)</span></span
          >
        </div>
      </div>
    </div>

    <div class="bar-row">
      <div class="label">PyO3 / Python</div>
      <div class="bar-container">
        <div class="bar others" style="width: 28%;">
          <span class="value"
            >5,000.00 ops/s <span class="ms">(0.20ms)</span></span
          >
        </div>
      </div>
    </div>

    <div class="bar-row">
      <div class="label">gRPC</div>
      <div class="bar-container">
        <div class="bar others" style="width: 24%;">
          <span class="value"
            >4,000.00 ops/s <span class="ms">(0.25ms)</span></span
          >
        </div>
      </div>
    </div>

    <div class="bar-row">
      <div class="label">Redis</div>
      <div class="bar-container">
        <div class="bar others" style="width: 16%;">
          <span class="value"
            >2,222.22 ops/s <span class="ms">(0.45ms)</span></span
          >
        </div>
      </div>
    </div>

    <div class="bar-row">
      <div class="label">FastAPI (HTTP)</div>
      <div class="bar-container">
        <div class="bar others" style="width: 10%;">
          <span class="value"
            >1,162.79 ops/s <span class="ms">(0.86ms)</span></span
          >
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .benchmark-container {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
    margin: 2rem 0;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .benchmark-header h3 {
    margin-top: 0 !important;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    color: var(--sl-color-white);
  }

  .benchmark-header p {
    margin-top: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 1rem;
  }

  .chart {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .label {
    width: 120px;
    flex-shrink: 0;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    text-align: right;
  }

  .bar-container {
    flex-grow: 1;
    background: var(--sl-color-gray-6);
    border-radius: 4px;
    height: 28px;
    position: relative;
    overflow: hidden;
  }

  .bar {
    height: 100%;
    border-radius: 4px;
    display: flex;
    align-items: center;
    min-width: 0;
    transition: width 1s ease-in-out;
  }

  .bar.transit {
    background: #c8a22b;
  }

  .bar.others {
    background: var(--sl-color-gray-4);
  }

  .value {
    padding-left: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-white);
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .ms {
    font-weight: 400;
    margin-left: 0.35rem;
  }

  @media (max-width: 600px) {
    .bar-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .label {
      width: 100%;
      text-align: left;
    }
    .bar-container {
      width: 100%;
    }
    .chart {
      gap: 1rem;
    }
  }
</style>
