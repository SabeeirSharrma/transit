{
  "name": "transit",
  "version": "1.0.0",
  "description": "Languages that just talk to each other. No API. No middleman.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@sabeeirsharrma/schema": "workspace:*",
    "@sabeeirsharrma/scanner": "workspace:*",
    "@sabeeirsharrma/java-runtime": "workspace:*",
    "@sabeeirsharrma/python-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
