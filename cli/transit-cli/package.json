{
  "name": "transit-cli",
  "version": "1.0.0",
  "description": "Transit CLI — transit dev, transit build, transit start",
  "type": "module",
  "bin": {
    "transit": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "transit": "workspace:*",
    "@transit/schema": "workspace:*",
    "@transit/scanner": "workspace:*",
    "@transit/codegen": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
